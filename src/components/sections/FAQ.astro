---
// Native <details> accordion — zero JS. Schema-ready: pass the same `items`
// array to a FAQPage JSON-LD generator in Phase 6 (geo-aeo.md rule 8).
interface FAQItem {
  question: string;
  answer: string;
}
interface Props {
  title?: string;
  items: FAQItem[];
}
const { title = "Common Questions", items } = Astro.props;
---

<section class="section">
  <div class="container-content max-w-3xl">
    <h2 class="text-fluid-2xl">{title}</h2>
    <div class="mt-6 divide-y divide-sand-line border-y border-sand-line">
      {
        items.map((item) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display font-semibold text-ink marker:content-none">
              {item.question}
              <span aria-hidden="true" class="shrink-0 text-caliche-dark transition-transform group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="mt-3 text-fluid-base text-muted" set:html={item.answer} />
          </details>
        ))
      }
    </div>
  </div>
</section>
