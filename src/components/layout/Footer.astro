---
import { site } from "../../lib/site-config";

const currentYear = new Date().getFullYear();
---

<footer class="bg-iron-dark text-white">
  <div class="container-content section !py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="font-display text-fluid-lg font-bold uppercase tracking-wide">{site.brandName}</p>
        <p class="mt-2 text-fluid-sm text-white/70">{site.tagline}</p>
        {
          !site.phoneIsPlaceholder && (
            <a href={site.phoneHref} data-track="phone_click" class="btn-primary mt-4 inline-flex">
              Call {site.phoneDisplay}
            </a>
          )
        }
      </div>

      <div>
        <p class="text-fluid-sm font-display font-semibold uppercase tracking-[0.14em] text-white/60">Fencing</p>
        <ul class="mt-3 space-y-2 text-fluid-sm text-white/90">
          <li><a href="/services/fence-installation-yuma-az/" class="hover:text-white hover:underline">Fence Installation</a></li>
          <li><a href="/costs/fence-cost-yuma-az/" class="hover:text-white hover:underline">Fence Cost Guide</a></li>
          <li><a href="/services/fence-repair-yuma-az/" class="hover:text-white hover:underline">Fence Repair</a></li>
        </ul>
      </div>

      <div>
        <p class="text-fluid-sm font-display font-semibold uppercase tracking-[0.14em] text-white/60">Block Wall &amp; Masonry</p>
        <ul class="mt-3 space-y-2 text-fluid-sm text-white/90">
          <li><a href="/services/block-wall-installation-yuma-az/" class="hover:text-white hover:underline">Block Wall Installation</a></li>
          <li><a href="/costs/block-wall-cost-yuma-az/" class="hover:text-white hover:underline">Block Wall Cost Guide</a></li>
          <li><a href="/guides/yuma-fence-wall-permit-rules/" class="hover:text-white hover:underline">Permit &amp; Code Guide</a></li>
        </ul>
      </div>

      <div>
        <p class="text-fluid-sm font-display font-semibold uppercase tracking-[0.14em] text-white/60">Resources</p>
        <ul class="mt-3 space-y-2 text-fluid-sm text-white/90">
          <li><a href="/guides/fence-vs-block-wall-yuma/" class="hover:text-white hover:underline">Fence vs. Block Wall</a></li>
          <li><a href="/guides/fence-masonry-license-arizona/" class="hover:text-white hover:underline">License Guide (R-14 vs R-31)</a></li>
          <li><a href="/service-areas/" class="hover:text-white hover:underline">Service Areas</a></li>
          <li><a href="/best-fence-block-wall-companies-yuma-az/" class="hover:text-white hover:underline">Best Companies</a></li>
          <li><a href="/blog/" class="hover:text-white hover:underline">Blog</a></li>
          <li><a href="/about/" class="hover:text-white hover:underline">About</a></li>
          <li><a href="/contact/" class="hover:text-white hover:underline">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-white/15 pt-6 text-fluid-sm text-white/70">
      <p>Serving {site.serviceArea.cities.join(", ")}.</p>
      <!-- Third-party disclosure — rendered verbatim from site-config, once
           per surface (compliance.md rule 3). -->
      <p class="mt-3 max-w-3xl">{site.disclosure}</p>
      <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
        <span>&copy; {currentYear} {site.legalDisclaimerName}. All rights reserved.</span>
        <a href="/privacy-policy/" class="hover:text-white hover:underline">Privacy Policy</a>
        <a href="/terms/" class="hover:text-white hover:underline">Terms</a>
      </p>
    </div>
  </div>
</footer>
