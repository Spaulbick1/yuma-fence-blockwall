---
import Logo from "./Logo.astro";
import { site } from "../../lib/site-config";

const navLinks = [
  { label: "Fencing", href: "/services/fence-installation-yuma-az/" },
  { label: "Block Wall", href: "/services/block-wall-installation-yuma-az/" },
  { label: "Fence vs. Wall", href: "/guides/fence-vs-block-wall-yuma/" },
  { label: "Cost Guides", href: "/costs/fence-cost-yuma-az/" },
  { label: "Best Companies", href: "/best-fence-block-wall-companies-yuma-az/" },
  { label: "Contact", href: "/contact/" },
];
---

<header class="sticky top-0 z-40 border-b border-sand-line bg-paper/95 backdrop-blur">
  <div class="container-content flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 font-display text-fluid-lg font-bold uppercase tracking-wide text-iron-dark">
      <Logo />
      <span>{site.brandName}</span>
    </a>

    <nav class="hidden lg:flex items-center gap-6" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-fluid-sm font-medium text-ink hover:text-caliche-dark transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:flex items-center gap-3">
      {
        !site.phoneIsPlaceholder && (
          <a href={site.phoneHref} data-track="phone_click" class="btn-primary">
            Call {site.phoneDisplay}
          </a>
        )
      }
      <a href="/contact/#lead-form" class={site.phoneIsPlaceholder ? "btn-primary" : "btn-secondary"}>
        Get Free Quote
      </a>
    </div>

    <!-- Mobile menu trigger (vanilla script island, no framework) -->
    <button
      id="menu-toggle"
      class="lg:hidden inline-flex items-center justify-center rounded-card border border-sand-line p-2 text-iron-dark"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-sand-line bg-paper">
    <nav class="container-content flex flex-col gap-1 py-4" aria-label="Mobile">
      {
        navLinks.map((link) => (
          <a href={link.href} class="rounded-card px-3 py-2.5 text-fluid-base font-medium text-ink hover:bg-iron-50">
            {link.label}
          </a>
        ))
      }
      <div class="mt-3 flex flex-col gap-2 px-3">
        {
          !site.phoneIsPlaceholder && (
            <a href={site.phoneHref} data-track="phone_click" class="btn-primary justify-center">
              Call {site.phoneDisplay}
            </a>
          )
        }
        <a
          href="/contact/#lead-form"
          class={site.phoneIsPlaceholder ? "btn-primary justify-center" : "btn-secondary justify-center"}
        >
          Get Free Quote
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  function closeMenu() {
    menu?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
  }

  function openMenu() {
    menu?.classList.remove("hidden");
    toggle?.setAttribute("aria-expanded", "true");
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    isOpen ? closeMenu() : openMenu();
  });

  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });
</script>
