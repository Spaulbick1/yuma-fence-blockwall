// every other site's Logo.astro (re-grep in Phase 6/7 if this file changes).
---

<svg
  width="34"
  height="34"
  viewBox="0 0 34 34"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Yuma Fence & Wall logo mark"
>
  <!-- two posts -->
  <rect x="4" y="4" width="4" height="26" rx="1" fill="#20242A" />
  <rect x="26" y="4" width="4" height="26" rx="1" fill="#20242A" />
  <!-- two rails -->
  <rect x="4" y="11" width="26" height="3" fill="#6E6250" />
  <rect x="4" y="20" width="26" height="3" fill="#6E6250" />
</svg>
